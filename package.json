    "visualization",
    "diff-review",
    "plan-review",
    "slides",
    "pptx",
    "powerpoint",
    "mermaid"
  ],
  "files": [
    "plugins/visual-explainer",
    ".claude-plugin",
    "configs",
    "install-pi.sh",
