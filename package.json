  },
  "keywords": [
    "agent-skill",
    "pi-package",
    "claude-code-plugin",
    "claude-marketplace",
    "codex",
    "antigravity",
    "antigravity-cli",
    "mcp",
    "model-context-protocol",
    "opencode",
    "openclaw",
